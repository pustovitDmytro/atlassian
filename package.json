{
  "name": "atlassian",
  "version": "1.15.1",
  "description": "atlassian command line interface",
  "main": "./lib",
  "scripts": {
    "build": "babel src --out-dir ./lib --copy-files",
    "prepare": "npm run build && husky install",
    "coveralls": "cat ./reports/coverage/lcov.info | coveralls",
    "test:security": "npm audit --production && npm run test:lock",
    "test:lint": "eslint src bin tests --no-error-on-unmatched-pattern",
    "test:mocha": "mocha --config .mocharc.json 'tests/**/*test.js'",
    "test:package": "npt test -c .package-tester.json",
    "test:coverage": "BUILD=0 MODE=test nyc mocha --config .mocharc.json 'tests/**/*test.js'",
    "test:debt": "jscpd src --config .jscpd.json",
    "test:lock": "lockfile-lint --path package-lock.json --validate-https --allowed-hosts npm",
    "coverage-check": "MODE=test nyc check-coverage",
    "test": "npm run test:lint && npm run test:security && BUILD=1 npm run test:mocha",
    "sort-deps": "npm remove --save example; npm remove --save-dev example",
    "semantic-release": "npx semantic-release"
  },
  "keywords": [
    "atlassian",
    "jira",
    "confluence",
    "cli",
    "automation"
  ],
  "bin": {
    "jira": "lib/bin/jira.js",
    "confluence": "lib/bin/confluence.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pustovitDmytro/atlassian.git"
  },
  "author": "Dmytro Pustovit",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pustovitDmytro/atlassian/issues"
  },
  "engines": {
    "node": ">=10"
  },
  "homepage": "https://github.com/pustovitDmytro/atlassian#readme",
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/node": "^8.0.1",
    "@babel/plugin-proposal-class-properties": "^7.16.7",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-proposal-object-rest-spread": "^7.16.7",
    "@babel/plugin-proposal-optional-chaining": "^7.16.7",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/runtime": "^8.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/lint": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-shebang": "^1.0.0",
    "chai": "^6.2.2",
    "chance": "^1.1.8",
    "cls-hooked": "^4.2.2",
    "conventional-changelog-eslint": "^6.1.0",
    "coveralls": "^3.1.1",
    "danger": "^14.0.7",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-incredible": "^2.4.1",
    "eslint-plugin-censor": "^1.5.2",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-scanjs-rules": "^0.2.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "fs-extra": "^11.4.0",
    "husky": "^9.1.7",
    "jscpd": "^5.1.1",
    "json-query": "^2.2.2",
    "lockfile-lint": "^5.0.1",
    "mocha": "^12.0.0",
    "mocha-junit-reporter": "^2.0.2",
    "mock-stdin": "^1.0.0",
    "node-package-tester": "^1.3.4",
    "nyc": "^18.0.0",
    "semantic-release": "^25.0.9",
    "semantic-release-telegram": "^1.6.0",
    "test-console": "^2.0.0",
    "winston-array-transport": "^1.1.7"
  },
  "dependencies": {
    "base-api-client": "1.5.8",
    "chalk": "4.1.2",
    "dayjs": "1.10.7",
    "fs-extra": "10.0.0",
    "html-to-text": "8.1.0",
    "inquirer": "8.2.0",
    "ms": "2.1.3",
    "myrmidon": "1.7.2",
    "triple-beam": "1.3.0",
    "uuid": "8.3.2",
    "winston": "3.6.0",
    "yargs": "17.3.1"
  }
}
